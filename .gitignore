# ==========================================
# 1. GENERAL (Archivos del Sistema operativo y Editores)
# ==========================================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# 2. BACKEND (Node.js, Express, Sequelize, Nodemon)
# ==========================================
backend/node_modules/
backend/dist/
backend/build/

# Variables de entorno y secretos
backend/.env
backend/.env.*
!backend/.env.example

# Bases de datos locales de desarrollo (ej. SQLite si usas Sequelize localmente)
backend/*.sqlite
backend/*.sqlite3
backend/database.sqlite
backend/database.sqlite-*

# Archivos de estado o temporales de Nodemon y logs de ejecución
backend/.nodemonstate
backend/logs/
backend/temp/

# ==========================================
# 3. FRONTEND (Angular)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/out-tsc/
frontend/.angular/
frontend/tmp/

# Archivos de compilación y pruebas de Angular
frontend/e2e/*.js
frontend/e2e/*.d.ts
frontend/coverage/

# Variables de entorno locales de Angular (si manejas archivos sensibles locales)
frontend/.env
frontend/.env.local